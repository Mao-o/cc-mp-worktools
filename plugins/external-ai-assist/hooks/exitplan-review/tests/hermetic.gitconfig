# テストが git に読ませる global config (_testutil.py の HERMETIC_GIT_ENV の GIT_CONFIG_GLOBAL が指す)。
# 開発者の ~/.gitconfig の代わりに、自動 gc / maintenance を止める設定だけを持つ。理由は
# post-implementation-review/tests/_testutil.py の NO_BACKGROUND_GIT_SETTINGS のコメント
# (そちらの tests/hermetic.gitconfig と同じ中身。意図した複製)。
# テストから git config --global で書かないこと (この tracked の file が書き換わる)。
[maintenance]
	auto = false
	autoDetach = false
[gc]
	auto = 0
	autoDetach = false
[receive]
	autogc = false
